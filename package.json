{
  "name": "@t3tools/monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/desktop",
      "apps/desktop-mirin",
      "apps/server",
      "apps/web",
      "packages/*",
      "scripts",
      "oxlint-plugin-t3code"
    ],
    "catalog": {
      "@clerk/backend": "3.18.1",
      "@clerk/clerk-js": "6.32.1",
      "@clerk/electron": "0.0.44",
      "@clerk/electron-passkeys": "0.0.3",
      "@clerk/expo": "4.6.8",
      "@clerk/react": "6.16.1",
      "@clerk/shared": "4.33.0",
      "@effect/atom-react": "4.0.4",
      "@effect/openapi-generator": "4.0.4",
      "@effect/platform-node": "4.0.4",
      "@effect/platform-node-shared": "4.0.4",
      "@effect/sql-pg": "4.0.4",
      "@effect/sql-sqlite-do": "4.0.4",
      "@effect/tsgo": "0.51.1",
      "@effect/vitest": "4.0.4",
      "@electron-webauthn/macos": "1.3.1",
      "@legendapp/list": "3.3.5",
      "@noble/curves": "1.9.1",
      "@noble/hashes": "1.8.0",
      "@pierre/diffs": "1.5.2",
      "@tailwindcss/node": "4.3.3",
      "@tailwindcss/oxide": "4.3.3",
      "@tailwindcss/vite": "4.3.3",
      "@types/node": "24.12.4",
      "@types/plist": "3.0.5",
      "@types/ws": "8.18.2",
      "effect": "4.0.4",
      "electron-webauthn": "1.3.1",
      "jose": "6.2.2",
      "lightningcss": "1.33.0",
      "objc-js": "1.5.0",
      "plist": "3.1.1",
      "tailwindcss": "4.3.3",
      "tldts": "7.4.2",
      "typescript": "7.0.2",
      "undici": "8.11.2",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
      "vite-plus": "1.0.0",
      "ws": "8.22.0",
      "yaml": "^2.9.0",
      "mdast-util-directive": "3.1.0",
      "micromark-extension-directive": "4.0.0",
      "micromark-util-character": "2.1.1",
      "micromark-util-types": "2.0.2",
      "rehype-raw": "7.0.0",
      "rehype-sanitize": "6.0.0",
      "remark-breaks": "4.0.0",
      "remark-gfm": "4.0.1",
      "remark-parse": "11.0.0",
      "remark-rehype": "11.1.2",
      "unified": "11.0.5"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch && vp config --no-agent",
    "dev": "node scripts/dev-runner.ts dev",
    "dev:share": "node scripts/dev-runner.ts dev --share",
    "dev:server": "node scripts/dev-runner.ts dev:server",
    "dev:web": "node scripts/dev-runner.ts dev:web",
    "dev:marketing": "vp run --filter @t3tools/marketing dev",
    "dev:desktop": "node scripts/dev-runner.ts dev:desktop",
    "migrate-dev-db": "node apps/server/scripts/migrate-dev-db.ts",
    "start": "vp run --filter t3 start",
    "start:desktop": "vp run --filter @t3tools/desktop start",
    "start:marketing": "vp run --filter @t3tools/marketing preview",
    "start:mock-update-server": "node scripts/mock-update-server.ts",
    "screenshots:mobile": "node scripts/mobile-showcase.ts",
    "icons:export": "node scripts/export-brand-icons.ts",
    "icons:check": "node scripts/export-brand-icons.ts --check",
    "licenses:sync": "node scripts/sync-third-party-license-notices.ts",
    "icons:export:android": "node scripts/export-android-icons.ts",
    "build": "vp run --filter './apps/*' build",
    "build:marketing": "vp run --filter @t3tools/marketing build",
    "build:desktop": "vp run --filter @t3tools/desktop --filter t3 build",
    "build:resource-monitor": "cargo build --locked --release --manifest-path native/resource-monitor/Cargo.toml",
    "typecheck": "vp run -r --concurrency-limit 2 typecheck",
    "tc": "vp run -r --concurrency-limit 2 typecheck",
    "lint": "vp lint --report-unused-disable-directives",
    "knip": "knip --preprocessor ./scripts/knip-schemas.ts",
    "knip:check": "knip --include files,dependencies --no-config-hints && knip --workspace apps/server --workspace apps/desktop --workspace apps/web --workspace packages/client-runtime --workspace packages/contracts --workspace packages/effect-acp --workspace packages/effect-codex-app-server --workspace packages/shared --workspace packages/ssh --workspace packages/tailscale --workspace packages/provider-core --workspace packages/provider-acp --workspace packages/provider-acp-registry --workspace packages/provider-testing --workspace packages/provider-pi --workspace packages/provider-muse --workspace packages/provider-opencode --workspace packages/provider-cursor --workspace packages/provider-grok --workspace packages/source-control-core --workspace packages/source-control-azure-devops --workspace packages/source-control-bitbucket --workspace packages/source-control-forgejo --workspace packages/source-control-gitcafe --workspace packages/source-control-github --workspace packages/source-control-gitlab --workspace packages/source-control-testing --exports --preprocessor ./scripts/knip-schemas.ts --no-config-hints",
    "knip:production": "knip --production --preprocessor ./scripts/knip-schemas.ts",
    "lint:mobile": "node scripts/mobile-native-static-check.ts",
    "test": "vp run -r test",
    "test:perf:v2-wire": "vp test run apps/server/src/orchestration-v2/WireProjection.test.ts apps/server/src/orchestration-v2/threadHistoryPaging.test.ts apps/server/src/orchestration-v2/ThreadStream.test.ts apps/server/src/orchestration-v2/ThreadTransportPerformance.test.ts apps/server/src/orchestration-v2/ShellStream.test.ts apps/server/src/orchestration-v2/CommandPolicy.test.ts apps/server/src/orchestration-v2/runtimeLayer.test.ts apps/server/src/ws.test.ts packages/contracts/src/environmentHttp.test.ts packages/contracts/src/orchestrationV2.test.ts packages/client-runtime/src/operations/commands.test.ts packages/client-runtime/src/operations/commands.performance.test.ts packages/client-runtime/src/state/boundedThreadSnapshotHttp.test.ts packages/client-runtime/src/state/threadHistoryController.test.ts packages/client-runtime/src/state/threadHistoryMerge.test.ts packages/client-runtime/src/state/threadDetail.test.ts packages/client-runtime/src/state/threads-sync.test.ts packages/client-runtime/src/state/shellReducer.test.ts",
    "test:resource-monitor": "cargo test --locked --manifest-path native/resource-monitor/Cargo.toml",
    "test:desktop-smoke": "vp run --filter @t3tools/desktop smoke-test",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "dist:desktop:artifact": "node scripts/build-desktop-artifact.ts",
    "dist:desktop:dmg": "node scripts/build-desktop-artifact.ts --platform mac --target dmg",
    "dist:desktop:dmg:arm64": "node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch arm64",
    "dist:desktop:dmg:x64": "node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch x64",
    "dist:desktop:linux": "node scripts/build-desktop-artifact.ts --platform linux --target AppImage --arch x64",
    "dist:gnome-extension": "gnome-extensions pack apps/desktop/gnome-extension --extra-source=captureService.js --extra-source=captureFeedback.js --extra-source=feedbackGeometry.js --out-dir=release --force",
    "dist:desktop:win": "node scripts/build-desktop-artifact.ts --platform win --target nsis",
    "dist:desktop:win:arm64": "node scripts/build-desktop-artifact.ts --platform win --target nsis --arch arm64",
    "dist:desktop:win:x64": "node scripts/build-desktop-artifact.ts --platform win --target nsis --arch x64",
    "release:smoke": "node scripts/release-smoke.ts",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist apps/*/dist-electron packages/*/dist .vite-plus apps/*/.vite-plus packages/*/.vite-plus",
    "sync:repos": "node scripts/sync-reference-repos.ts"
  },
  "devDependencies": {
    "@coderabbitai/config": "1.1.0",
    "@effect/tsgo": "catalog:",
    "@shadcn/lint": "0.1.5",
    "@types/node": "catalog:",
    "knip": "6.34.0",
    "tsc-rs": "0.7.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "@clerk/backend": "3.18.1",
    "@clerk/clerk-js": "6.32.1",
    "@clerk/electron": "0.0.44",
    "@clerk/electron-passkeys": "0.0.3",
    "@clerk/react": "6.16.1",
    "@clerk/shared": "4.33.0",
    "@effect/atom-react": "4.0.4",
    "@effect/platform-node": "4.0.4",
    "@effect/platform-node-shared": "4.0.4",
    "@effect/sql-pg": "4.0.4",
    "@effect/vitest": "4.0.4",
    "@electron-webauthn/macos>objc-js": "1.5.0",
    "@exodus/bytes>@noble/hashes": "1.8.0",
    "@opencode/protocol>effect": "4.0.4",
    "@opencode/schema>effect": "4.0.4",
    "@pierre/diffs>@shikijs/transformers": "^4.2.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.12.4",
    "effect": "4.0.4",
    "electron-webauthn>@electron-webauthn/macos": "1.3.1",
    "lightningcss": "1.33.0",
    "node-abi": "4.33.0",
    "tailwindcss": "4.3.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": "^24.13.1"
  },
  "packageManager": "bun@1.4.0",
  "patchedDependencies": {
    "@effect/vitest@4.0.4": "patches/@effect__vitest@4.0.4.patch",
    "@ff-labs/fff-node@0.11.0": "patches/@ff-labs__fff-node@0.11.0.patch",
    "@legendapp/list@3.3.5": "patches/@legendapp__list@3.3.5.patch",
    "@pierre/diffs@1.5.2": "patches/@pierre%2Fdiffs@1.5.2.patch",
    "dbus-next@0.10.2": "patches/dbus-next@0.10.2.patch",
    "node-pty@1.2.0-beta.15": "patches/node-pty@1.2.0-beta.15.patch"
  },
  "trustedDependencies": [
    "esbuild",
    "msgpackr-extract",
    "node-pty",
    "sharp",
    "tsc-rs"
  ]
}
